# improv service configuration. Copy to .env and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and .dockerignored — it must never reach an image layer.
# Note that env values are visible via `docker inspect` regardless of whether
# they come from env_file or from `environment:`; env_file's benefit is that the
# secrets stay out of the committed compose file. If that is not good enough,
# switch to Docker secrets mounted as files plus an entrypoint that exports them.
#
# There is no dotenv support in the application itself — config is read straight
# from os.environ, so compose's env_file is the entire loading mechanism. Running
# outside compose means exporting these yourself.

# ---------------------------------------------------------------------- auth --
# Required. The service refuses to start without it rather than serving an
# unprotected API. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
IMPROV_API_TOKEN=

# ------------------------------------------------------------------ postgres --
# Consumed by the postgres image on first initialization of the volume. Changing
# POSTGRES_PASSWORD later does not change the existing database's password.
POSTGRES_USER=improv
POSTGRES_PASSWORD=
POSTGRES_DB=improv

# Required by the service and by `improv db upgrade`. Host is the compose service
# name. The password must match POSTGRES_PASSWORD above — it is spelled twice
# because the URL is opaque to compose.
IMPROV_DATABASE_URL=postgresql+psycopg2://improv:CHANGEME@db:5432/improv

# ------------------------------------------------------------- columnar store --
IMPROV_DB_BACKEND=vastdb
IMPROV_VASTDB_ENDPOINT=
IMPROV_VASTDB_ACCESS_KEY=
IMPROV_VASTDB_SECRET_KEY=
IMPROV_VASTDB_BUCKET=
IMPROV_VASTDB_SCHEMA=improv

# DuckDB backend only — leave unset when IMPROV_DB_BACKEND=vastdb.
# IMPROV_DB_ROOT=s3://bucket/prefix
# IMPROV_S3_ENDPOINT=vast-s3.whoi.edu:9000     # bare host:port, no scheme
# IMPROV_S3_ACCESS_KEY=
# IMPROV_S3_SECRET_KEY=
# IMPROV_S3_USE_SSL=true
# IMPROV_DUCKDB_THREADS=

# --------------------------------------------------------------- object store --
# Image bytes and blobs. Configure exactly one of the two blocks below; if both
# are set, S3 wins.
#
# VAST S3 has no signed-URL support, so reads proxy through the service either way.

# S3. Note the endpoint is a full URL *with scheme* — this differs from
# IMPROV_S3_ENDPOINT above, which DuckDB/PyArrow want as a bare host:port.
IMPROV_OBJECT_BUCKET=
IMPROV_OBJECT_S3_ENDPOINT=https://vast.example.org
IMPROV_OBJECT_S3_ACCESS_KEY=
IMPROV_OBJECT_S3_SECRET_KEY=
# CA bundle path *inside the container*, for an internally-signed endpoint.
# IMPROV_OBJECT_S3_CA_BUNDLE=/etc/ssl/certs/whoi-internal-ca.crt

# Filesystem alternative. Requires the bind mount in docker-compose.yml, and the
# path must be writable by IMPROV_UID:IMPROV_GID.
# IMPROV_STORAGE_PATH=/data/objects

# -------------------------------------------------------- plugins and parsers --
# No defaults — an unset value registers no plugins and no ID parsers, which
# looks like a healthy service that returns nothing. An unknown name fails
# startup rather than silently no-opping.
#
# The set below is what IFCB ingest constructs (ifcb-ingest ingest.py, validate.py).
# Available plugins: geolocation, sample_context, blob, machine_classification,
# ifcb_features, ifcb_cnn_classification. Available parsers: ifcb.
#
# machine_classification is the generic base that ifcb_cnn_classification
# specializes; including both would register an unused index table.
IMPROV_PLUGINS=geolocation,sample_context,blob,ifcb_features,ifcb_cnn_classification
IMPROV_PARSERS=ifcb

# -------------------------------------------------------------------- server --
# uvicorn worker processes. Each worker runs the lifespan independently and gets
# its own columnar-store connection; sessions are already per-request. VAST DB
# supports concurrent multi-process access, so >1 is safe.
WEB_CONCURRENCY=4

# The reverse proxy is outside Docker, so its address as seen from inside the
# container is the Docker bridge gateway, not 127.0.0.1 (uvicorn's default).
# Without this, X-Forwarded-For/-Proto are ignored and client IP and scheme are
# wrong in logs and redirects. Find it with:
#   docker network inspect improv_default -f '{{(index .IPAM.Config 0).Gateway}}'
FORWARDED_ALLOW_IPS=172.18.0.1

# ------------------------------------------------------------------ identity --
# Build-time UID/GID for the container user. Match the owner of any bind-mounted
# IMPROV_STORAGE_PATH, or writes to it will fail with EACCES.
IMPROV_UID=1000
IMPROV_GID=1000

# ------------------------------------------------------------- internal CA -----
# Only if the VAST endpoints use an internally-signed certificate. vastdb goes
# through requests/aws-requests-auth; boto3 uses botocore's own bundle and reads
# the IMPROV_OBJECT_S3_CA_BUNDLE setting above instead.
# SSL_CERT_FILE=/etc/ssl/certs/whoi-internal-ca.crt
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/whoi-internal-ca.crt
